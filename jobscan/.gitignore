# Scratch job lists written while probing (probe-jobs.json, run4-jobs.json...)
*-jobs.json
probe*.json

# Replay corpus: captured from your own runs -- your answers, your resume and
# the employers' pages. Local only; the README stays.
tests/recovery_replay/*
!tests/recovery_replay/README.md
